<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create a new car</title>
</head>

<body>
    <%- include('./partials/navbar')%>
    <h1>Create a new car</h1>
    <form action="/new" method="post">
        <label for="name">name</label>
        <input minlength="4" maxlength="25" placeholder="The car name" required name="name" id="name" type="text">
        <br>
        <label for="year">Manufactur year</label>
        <input max="2027" min="1900" placeholder="year" required name="year" id="year" type="number">
        <br>
        <label for="companyName">Car company name</label>
        <input required name="companyName" minlength="4" maxlength="25" id="companyName" placeholder="Company name" type="text">
        <br>
        <label for="rating">Rating</label>
        <input required min="0" max="10" id="rating" placeholder="Rate the car" name="rating" type="number">
        <br>
        <label for="size">How many seats</label>
        <input required min="1" max="50" name="size" id="size" placeholder="Seats in the car" type="number">
        <br>
        <button>Create</button>
    </form>
</body>

</html>